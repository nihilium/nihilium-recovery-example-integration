# Copy to .env.local. Nothing here is required: the app runs with no env at all, in simulated mode,
# against public RPCs.

# simulated (default) | live.  live is PAID and blocks on a human answering an email.
VITE_RECOVERY_MODE=simulated

VITE_SERVER_URL=http://localhost:8787
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BUNDLER_URL=https://public.pimlico.io/v2/11155111/rpc

# Must match server/.env. Both are demo shared secrets, not capabilities worth protecting.
VITE_RECORD_APPEND_SECRET=demo-append-secret
VITE_WATCH_REGISTER_SECRET=demo-watch-secret

# Live mode only. This key reaches the browser — an accepted demo trade-off (it is a spend limit on
# sealing, not access to funds). A real wallet keeps its payment provider behind its own backend.
VITE_NIHILIUM_API_KEY=
VITE_NIHILIUM_API_URL=https://api.nihilium.io
VITE_NIHILIUM_EMAIL_SERVICE_URL=https://zkemail.nihilium.io
