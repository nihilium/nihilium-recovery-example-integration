# The template. `npm install` copies this to .env and fills in the generated secrets — edit that
# file, not this one. Everything except those two secrets has a working default.

PORT=8787
CORS_ORIGIN=http://localhost:5173
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Roles are account indices against ONE phrase, so each role gets a key on every chain it acts on,
# in that chain's own curve and derivation path. Blank means the PUBLIC demo mnemonic: stable across
# restarts, known to everyone, fine for testnet dust and wrong for anything else.
ROLE_MNEMONIC=

# Per-role overrides, and the shape a real deployment uses: the three veto authorities are meant to
# be three parties, and parties do not share a seed. Any role set here stops being derived.
# secp256k1 (EVM) only — a chain on another curve needs its own variable, because 32 bytes say
# nothing about which curve they belong to.
# Generate: node -e "console.log(require('viem/accounts').generatePrivateKey())"
RELAYER_PRIVATE_KEY=
PAUSE_AUTHORITY_PRIVATE_KEY=
ABORT_AUTHORITY_PRIVATE_KEY=
# Comma-separated. Length sets n; RESUME_THRESHOLD sets k.
RESUME_MEMBER_PRIVATE_KEYS=
RESUME_THRESHOLD=2

# Veto clock, in wall-clock seconds (v2 of the module; v1 counted blocks).
TIMELOCK_SECONDS=300
PAUSE_CEILING_SECONDS=900

# Record host and watchtower state. Both are ciphertext-and-metadata only; neither holds a seal.
RECORDS_DIR=./.data/records
WATCHES_DIR=./.data/watches
# Generated per machine by scripts/setup-env.mjs, and matched in app/.env.local.
RECORD_APPEND_SECRET=
WATCH_REGISTER_SECRET=

# 300 in production (the watchtower README's figure). 15 here so a scenario does not sit waiting.
WATCHTOWER_POLL_SECONDS=15
# Adds POST /api/watchtower/poll, which the watchtower's own API deliberately does not have.
DEMO_ALLOW_FORCED_POLL=true

# Ceiling on POST /api/roles/relayer/fund (wei). Default 0.02 ETH.
DEMO_FUND_MAX_WEI=20000000000000000

# LOG_STACKS=1 for full stack traces.
