# @zkpassport/sdk@0.16.2 declares typescript@^5 as a peer; the app builds on typescript 6. The peer
# is for its .d.ts files only, and 0.16.2 is pinned because it and @zkpassport/utils@0.37.5 are what
# nihilium-core's passport commitments are built against — 0.17 moves to utils 0.38.
legacy-peer-deps=true
